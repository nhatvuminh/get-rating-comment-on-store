{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MB Presentation Input",
  "type": "object",
  "required": ["slides"],
  "properties": {
    "meta": { "type": "object" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["layout"],
        "properties": {
          "layout": { "type": "string" },
          "title": { "type": "string", "maxLength": 86 },
          "subtitle": { "type": "string" },
          "body": { "type": "string" },
          "kpis": { "type": "array" },
          "chart": { "type": "object" },
          "rows": { "type": "array" }
        },
        "additionalProperties": true
      }
    }
  }
}
